{
  "name": "react-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@loadable/component": "^5.16.7",
    "@loadable/server": "^5.16.7",
    "@sanity/client": "^7.6.0",
    "@sanity/image-url": "^1.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "compression": "^1.8.1",
    "construct-style-sheets-polyfill": "^3.1.0",
    "cookie": "^1.0.2",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "lottie-web": "^5.13.0",
    "p5": "^2.0.3",
    "q5": "^3.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0",
    "react-router-dom": "^7.8.0",
    "react-shadow": "^20.6.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "webpack serve --config webpack.client.js --mode=development",
    "build": "webpack --config webpack.client.js --mode=production",
    "build:ssr": "webpack --config webpack.server.js --mode=production",
    "typecheck": "tsc --noEmit",
    "dev:ssr": "concurrently -k -n CLIENT,SSR-BUILD,SSR -s first \"npm:dev:client\" \"npm:dev:ssr:watch\" \"npm:dev:ssr:run\"",
    "dev:client": "cross-env PORT=3000 HOST=0.0.0.0 webpack serve --config webpack.client.js --mode=development",
    "dev:ssr:watch": "webpack --config webpack.server.js --mode=development --watch",
    "dev:ssr:run": "cross-env NODE_ENV=development nodemon --watch build-ssr --ext js --exec node build-ssr/server.js",
    "dev:ssr:only": "cross-env NODE_ENV=development node build-ssr/server.js",
    "start:ssr": "cross-env NODE_ENV=production node build-ssr/server.js",
    "clean": "rimraf build build-ssr loadable-stats.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.28.0",
    "@loadable/babel-plugin": "^5.16.1",
    "@loadable/webpack-plugin": "^5.15.2",
    "@types/postcss-prefix-selector": "^1.16.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.8",
    "http-proxy-middleware": "^3.0.5",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.10",
    "null-loader": "^4.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "postcss-prefix-selector": "^2.1.1",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "typescript": "6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}
